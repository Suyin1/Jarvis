{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Check Report",
  "description": "资料质量检查报告的统一格式",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "check_id": {"type": "string", "description": "检查唯一标识"},
        "timestamp": {"type": "string", "format": "date-time"},
        "check_type": {
          "type": "string",
          "enum": ["all", "format", "style", "structure", "code", "consistency"]
        },
        "target": {"type": "string", "description": "检查目标路径"},
        "knowledge_version": {"type": "string"}
      },
      "required": ["check_id", "timestamp", "check_type", "target"]
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {"type": "integer"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "warnings": {"type": "integer"},
        "suggestions": {"type": "integer"},
        "needs_review": {"type": "integer"},
        "score": {"type": "number"}
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {"type": "string"},
          "rule_name": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "suggestion", "needs_review"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "needs_review"]
          },
          "message": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "column": {"type": "integer"},
          "section": {"type": "string"},
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "suggestion": {"type": "string"},
          "evidence": {"type": "string"}
        },
        "required": ["rule_id", "severity", "status", "message"]
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {"type": "string"},
          "tool": {"type": "string"},
          "duration_ms": {"type": "integer"},
          "status": {"type": "string"}
        }
      }
    }
  },
  "required": ["metadata", "summary", "details"]
}
